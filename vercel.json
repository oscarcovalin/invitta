{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/invitation-meta.js": {
      "includeFiles": "{invitacion.html,dist/invitacion.html}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/administracion/admin\\.html/?$",
      "headers": {
        "Location": "/administracion/studio-login.html"
      },
      "status": 307
    },
    {
      "src": "/plantillas/elegance/?$",
      "headers": {
        "Location": "/demos/xv-elegance/index.html"
      },
      "status": 308
    },
    {
      "src": "/plantillas/paquete2/?$",
      "headers": {
        "Location": "/demos/xv-premium-2/index.html"
      },
      "status": 308
    },
    {
      "src": "/plantillas/paquete3/?$",
      "headers": {
        "Location": "/demos/xv-vip-3/index.html"
      },
      "status": 308
    },
    {
      "src": "/plantillas/boda-classic-basic/?$",
      "headers": {
        "Location": "/demos/boda-classic-basic/index.html"
      },
      "status": 308
    },
    {
      "src": "/plantillas/boda-golden-romance/?$",
      "headers": {
        "Location": "/demos/boda-golden-romance-premium/index.html"
      },
      "status": 308
    },
    {
      "src": "/plantillas/boda1/?$",
      "headers": {
        "Location": "/demos/boda-premium-1/index.html"
      },
      "status": 308
    },
    {
      "src": "/invitacion\\.html$",
      "dest": "/api/invitation-meta"
    }
  ]
}
