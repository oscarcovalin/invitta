:root {
    --primary-color: #bfa59a; /* Tono Nude elegante / Champagne apagado */
    --primary-dark: #9c8477;
    --text-light: #f7f6f4;
    --text-dark: #333;
    --bg-color: #1c1a19; /* Gris oscuro muy cálido y neutral */
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.08);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-light);
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
}

h1, h2, h3, h4, .pre-title, .hashtag {
    font-family: 'Brittany Signature', cursive;
    font-weight: 400;
}

/* Animación de fondo sutil */
.background-animation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    background: radial-gradient(circle at 50% 50%, #2a2826 0%, #1c1a19 100%);
    overflow: hidden;
}

.background-animation::before,
.background-animation::after {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(191, 165, 154, 0.1), transparent 70%);
    animation: float 20s infinite alternate ease-in-out;
}

.background-animation::before {
    top: -15%;
    left: -15%;
}

.background-animation::after {
    bottom: -15%;
    right: -15%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.05), transparent 70%);
    animation-duration: 25s;
    animation-direction: alternate-reverse;
}

@keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(150px, 150px) scale(1.2); }
}

.section {
    min-height: 100vh;
    padding: 100px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
}

.text-center { text-align: center; }
.w-full { width: 100%; }
.mb-4 { margin-bottom: 2rem; }

/* Efecto Glassmorphism Premium */
.glass-panel, .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
}

.glass-panel::before, .glass-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.03), transparent);
    transform: skewX(-20deg);
    transition: 0.7s;
}

.glass-card:hover::before {
    left: 200%;
}

.glass-panel {
    padding: 4rem 2rem;
    text-align: center;
    max-width: 850px;
    margin: 0 auto;
}

.glass-card {
    padding: 3rem 2rem;
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
}

.glass-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 20px 40px rgba(191, 165, 154, 0.15);
    border-color: rgba(191, 165, 154, 0.3);
}

/* Tipografía de la cabecera */
.hero {
    background-image: linear-gradient(rgba(11, 15, 25, 0.6), rgba(11, 15, 25, 0.9)), url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&q=80&w=1920');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
}

.text-fade-in {
    animation: fadeInDown 1.5s ease-out;
}

@keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-30px); }
    to { opacity: 1; transform: translateY(0); }
}

.pre-title {
    font-size: 2rem;
    color: var(--primary-color);
    margin-bottom: 1rem;
    font-weight: 400;
}

.title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    margin-bottom: 0.5rem;
    background: linear-gradient(45deg, #fff, var(--primary-color), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 5s linear infinite;
    text-shadow: 0px 4px 15px rgba(0,0,0,0.4);
    line-height: 1.2;
}

@keyframes shine {
    to { background-position: 200% center; }
}

.date {
    font-size: 1.3rem;
    letter-spacing: 3px;
    margin-bottom: 2.5rem;
    text-transform: uppercase;
    font-weight: 400;
}

/* Temporizador Countdown */
.countdown {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
}

.time-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 90px;
    background: rgba(0,0,0,0.2);
    padding: 15px;
    border-radius: 15px;
    border: 1px solid rgba(191, 165, 154, 0.2);
}

.time-box span {
    font-size: 3rem;
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    color: var(--primary-color);
    line-height: 1;
    text-shadow: 0 0 20px rgba(191, 165, 154, 0.4);
}

.time-box small {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.8;
    margin-top: 8px;
}

/* Botones Premium */
.cta-button, .link-btn {
    display: inline-block;
    padding: 14px 34px;
    background-color: transparent;
    border: 1px solid var(--primary-color);
    color: #fff;
    text-decoration: none;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 40px;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    z-index: 1;
}

.cta-button::before, .link-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0%;
    height: 100%;
    background-color: var(--primary-color);
    transition: all 0.4s ease;
    z-index: -1;
}

.cta-button:hover::before, .link-btn:hover::before {
    width: 100%;
}

.cta-button:hover, .link-btn:hover {
    color: var(--bg-color);
    border-color: var(--primary-color);
    box-shadow: 0 0 20px rgba(191, 165, 154, 0.5);
}

.whatsapp-btn {
    display: inline-block;
    padding: 16px 42px;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: white;
    text-decoration: none;
    font-weight: 400;
    font-size: 1.1rem;
    border-radius: 40px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.3);
    border: 1px solid rgba(255,255,255,0.2);
}

.whatsapp-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.4);
}

/* Botón de Música Flotante */
.music-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 60px;
    height: 60px;
    background: var(--primary-color);
    border: none;
    border-radius: 50%;
    color: var(--bg-color);
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 1000;
    box-shadow: 0 4px 15px rgba(191, 165, 154, 0.4);
    transition: all 0.3s ease;
    display: flex;
    justify-content: center;
    align-items: center;
}

.music-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(191, 165, 154, 0.6);
}

.music-btn.playing {
    animation: pulseMusic 2s infinite;
}

@keyframes pulseMusic {
    0% { box-shadow: 0 0 0 0 rgba(191, 165, 154, 0.7); }
    70% { box-shadow: 0 0 0 15px rgba(191, 165, 154, 0); }
    100% { box-shadow: 0 0 0 0 rgba(191, 165, 154, 0); }
}

/* Secciones y Tarjetas */
.section-title {
    font-size: 4rem;
    text-align: center;
    margin-bottom: 3.5rem;
    color: var(--primary-color);
    position: relative;
    display: inline-block;
    padding-bottom: 15px;
}

.section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 2px;
    background-color: var(--primary-color);
}

.icon, .big-icon {
    color: var(--primary-color);
    margin-bottom: 1.5rem;
    text-shadow: 0 0 15px rgba(191, 165, 154, 0.3);
}

.icon { font-size: 3rem; }
.big-icon { font-size: 4.5rem; }

.cards-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
}

.time-highlight {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.4rem;
    color: var(--primary-color);
    margin: 15px 0;
    font-weight: 400;
}

.glass-card p {
    margin-bottom: 10px;
    color: #ddd;
}

.glass-card .link-btn {
    margin-top: 20px;
}

/* Itinerario / Timeline Elegante */
.timeline-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
}

.timeline-container::after {
    content: '';
    position: absolute;
    width: 2px;
    background: linear-gradient(to bottom, transparent, var(--primary-color), transparent);
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -1px;
}

.timeline-item {
    padding: 20px 50px;
    position: relative;
    width: 50%;
}

.timeline-item::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    right: -10px;
    background-color: var(--bg-color);
    border: 4px solid var(--primary-color);
    top: 25px;
    border-radius: 50%;
    z-index: 1;
    box-shadow: 0 0 10px var(--primary-color);
    transition: all 0.3s ease;
}

.timeline-item:hover::after {
    background-color: var(--primary-color);
    transform: scale(1.2);
}

.timeline-item:nth-child(even) { left: 50%; }
.timeline-item:nth-child(odd) { left: 0; text-align: right; }
.timeline-item:nth-child(even)::after { left: -10px; }

.timeline-item .time {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    color: var(--primary-color);
    font-size: 1.5rem;
    margin-bottom: 8px;
}

.timeline-item .content {
    padding: 25px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    transition: transform 0.3s ease;
}

.timeline-item:hover .content {
    transform: translateY(-5px);
    border-color: rgba(191, 165, 154, 0.3);
}

.timeline-item h4 {
    font-size: 1.3rem;
    margin-bottom: 5px;
    color: #fff;
}

/* Animaciones de Scroll */
.auto-fade {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.auto-fade.visible {
    opacity: 1;
    transform: translateY(0);
}

.rsvp-glow {
    box-shadow: 0 0 40px rgba(191, 165, 154, 0.1);
}

.dress-notes {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--glass-border);
}

/* Footer */
footer {
    text-align: center;
    padding: 4rem 2rem;
    background: rgba(0,0,0,0.8);
    border-top: 1px solid var(--glass-border);
    position: relative;
    z-index: 1;
}

.hashtag {
    color: var(--primary-color);
    font-size: 2.5rem;
    margin-top: 1.5rem;
    letter-spacing: 2px;
}

/* Sección Galería Horizontal (Scroll) */
.gallery-section {
    position: relative;
    height: 300vh; /* Permite hacer scroll varias veces la altura de la pantalla */
    background: transparent;
}

.gallery-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.gallery-track {
    display: flex;
    gap: 40px;
    padding: 0 50vw; /* Inicia y termina en el centro */
    width: max-content;
    will-change: transform;
    align-items: center;
}

.gallery-item {
    width: 320px;
    height: 480px;
    flex-shrink: 0;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border: 1px solid var(--glass-border);
    transition: transform 0.3s ease;
}

.gallery-item:nth-child(even) {
    transform: translateY(30px);
}

.gallery-item:nth-child(odd) {
    transform: translateY(-30px);
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
}

.gallery-item:hover img {
    transform: scale(1.1);
}

/* Responsive */
@media screen and (max-width: 768px) {
    .section { padding: 60px 15px; }
    
    /* Tipografía */
    .title { font-size: 3rem; }
    .section-title { font-size: 2.2rem; margin-bottom: 2.5rem; }
    .pre-title { font-size: 1.2rem; }
    
    /* Countdown */
    .countdown { gap: 10px; margin-bottom: 2.5rem; }
    .time-box { min-width: 70px; padding: 10px; }
    .time-box span { font-size: 2rem; }
    
    /* Paneles y Tarjetas */
    .glass-panel { padding: 2.5rem 1.5rem; }
    .glass-card { padding: 2rem 1.5rem; }

    /* Botones */
    .whatsapp-btn, .cta-button { 
        padding: 14px 20px; 
        font-size: 1rem; 
        width: 100%; 
        box-sizing: border-box; 
        display: block; 
        margin: 10px auto; 
    }
    
    /* Galería */
    .gallery-item {
        width: 260px;
        height: 380px;
    }
    
    /* Timeline */
    .timeline-container::after { left: 30px; }
    .timeline-item { width: 100%; padding-left: 70px; padding-right: 0px; padding-top: 15px; padding-bottom: 15px; text-align: left !important; }
    .timeline-item:nth-child(even) { left: 0; }
    .timeline-item::after { left: 20px !important; }
    .timeline-item .content { padding: 20px; }
}

@media screen and (max-width: 480px) {
    .title { font-size: 2.2rem; line-height: 1.2; }
    .section-title { font-size: 1.8rem; }
    .time-box { min-width: 60px; padding: 8px; }
    .time-box span { font-size: 1.5rem; }
    .time-box small { font-size: 0.7rem; }
    
    .gallery-item {
        width: 220px;
        height: 320px;
        border-radius: 15px;
    }
    .gallery-track { gap: 20px; }
    
    .cards-wrapper { gap: 1.5rem; }
    .icon { font-size: 2.5rem; }
    .big-icon { font-size: 3.5rem; }
    
    .timeline-item .time { font-size: 1.2rem; }
    .timeline-item h4 { font-size: 1.1rem; }
}
